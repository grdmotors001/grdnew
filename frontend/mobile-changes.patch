diff --git a/frontend/app/globals.css b/frontend/app/globals.css
index 3367479..36545f3 100644
--- a/frontend/app/globals.css
+++ b/frontend/app/globals.css
@@ -769,3 +769,32 @@ th[data-sortable][data-sort="desc"]::after{content:" \25BC";opacity:1}
   .sidebar .sidebarFooter{flex-shrink:0;padding-bottom:calc(8px + env(safe-area-inset-bottom,0px))}
 }
 @media(min-width:701px){.mobileLogout{display:none}}
+
+/* ===== MOBILE VIEW ONLY (max-width:700px) — requested UI changes =====
+   1. Log Out ab sirf Profile me (top bar se hata diya).
+   2. Dashboard cards 2 column me.
+   3. Header ka sub-menu strip 2-3 line me (wrap) — ek line ki scroll nahi.
+   4. Header ke shortcut / chat / notification / profile icons sirf Home tab par. */
+.mobileOnlyLogout{display:none}
+@media(max-width:700px){
+  .mobileOnlyLogout{display:block}
+
+  /* 2: dashboard cards double box */
+  .dashGrid,.gdCardGrid{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:10px !important}
+  .dashGrid .card,.gdCardGrid .card,.gdCardGrid button{padding:12px !important;min-width:0}
+  .dashGrid .metric{font-size:24px}
+  .dashGrid .card .muted{font-size:12px;overflow-wrap:anywhere}
+  .dashChartGrid{grid-template-columns:1fr !important}
+
+  /* 3: header strip -> 2-3 lines (max ~3 lines, uske baad andar scroll) */
+  .grdTopHeader .moduleStrip{
+    flex-wrap:wrap !important;overflow-x:visible !important;overflow-y:auto;
+    height:auto !important;max-height:118px;align-content:flex-start;gap:6px !important;
+  }
+  .grdTopHeader .moduleStripItem{padding:6px 10px !important;font-size:11px !important}
+
+  /* 4: icons sirf Home tab me; baaki tabs me hide */
+  .grdTopHeader .grdHeaderActions.hideMobileNotHome{display:none !important}
+  /* jis tab me strip bhi nahi aur icons bhi nahi, wahan khali green bar hata do */
+  .grdTopHeader.noStrip{display:none !important}
+}
