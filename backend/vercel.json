{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/backend/auth/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api/backend/auth",
      "dest": "api/index.py"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "api/auth.py"
    },
    {
      "src": "/api/auth",
      "dest": "api/auth.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}
